<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        The XML theme only has to carry the app through window creation now. Colours,
        shapes, typography and every widget style live in the Compose theme
        (ui/theme/Theme.kt), and the system bar appearance is applied at runtime by
        enableEdgeToEdge().

        A platform parent is used deliberately so the theme does not depend on AppCompat
        or Material Components: MainActivity is a plain ComponentActivity.
    -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
